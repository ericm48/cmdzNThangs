#!/bin/bash
# Handy dandy script that graps ALL kubeconfigs from a given mgmt-cluster.


#set -x

targetMCKC=

i=0
k=0
clusterDataJSON='./clusterZ.json'


usage(){
   			echo " "
   			echo " "
   			echo " "
        echo "Usage:   $0	-mc target-mgmt-cluster-k8s.conf  	-Graps ALL kubeconfigs from a given mgmt-cluster."
   			echo " "
   			echo " -H/-h                                          -Display this help message."
   			echo " "
   			echo " "
   			echo " Example:   $0 -mc /home/ubuntu/nkp.conf        -Downloads all workload-cluster kubeconfigs from management cluster referenced by /home/ubuntu/nkp.conf"
   			echo " "   			
   			echo " "
   			
	exit 1
}

arg_parse() {
	
	for (( i=1; i<=$#; i++)); do
		
		case ${!i} in
				 	
		  -mc)
		  		# targetMCKC -mc
		  	  k=$(($i+1))
				 	targetMCKC="${!k}"
				 	;;
	
	    -H)
					usage
					exit 3
	        ;;
	
	    -h)
					usage
					exit 3
					;;
	
	    --H)
					usage
					exit 3
	        ;;
	
	    --h)
					usage
					exit 3
					;;
	
	    -help)
					usage
					exit 3
	        ;;
	
	    --help)
					usage
					exit 3
					;;
			
			*)
					#echo "[$i]: ${!i}"
		
		
		esac
	
	  
	done

}

check_for_mc_kubeconfig() {

	echo " "
	echo "Checking For Target Management-Cluster-KubeConfig: $targetMCKC"

	if [ -f "$targetMCKC" ]
		then
	    	echo "Found Target Management-Cluster-KubeConfig: $targetMCKC"
	    	
	else
	    	echo "***ERROR: Cannot Find Target Management-Cluster-KubeConfig: $targetMCKC "
	    	exit 11	    
	fi
	
	echo " "

}

check_for_dependancyZ() {

	echo "Checking for CLI-Dependancies, Found: "

	depZ=("kubectl" "nkp" "jq")

	grepOut='./grep-out.txt'	
	rm $grepOut >/dev/null

	for dep in "${depZ[@]}"; do
	
	    #echo "Checking For Dependancy: $dep"
	
			which $dep | grep $dep > $grepOut	    
		  greprc=$?	    
	    
		  if [ $greprc -eq 0 ]
		  	then
		  		cat $grepOut
		  	
		  else
			  	echo "***ERROR: $dep-cli, NOT-Found!  Please Install...."
			  	exit 22  
			fi  
	    
	done
	
	echo " "
		    	
}

grab_cluster_data() {

	rm $clusterDataJSON >/dev/null
	  
  echo " "
	echo "Gathering Cluster Data..."  
  echo " "
  
	theCommand="kubectl --kubeconfig=$targetMCKC get clusters.cluster.x-k8s.io -A -o json"
	
	$theCommand > $clusterDataJSON

}


process_clusterZ() {

	clusterName=""
	clusterNameSpace=""
	
  echo " "
	echo "Clusters Found: "  	
  echo " "
    
  cat "$clusterDataJSON" | jq -r '.items[] | "\(.metadata.name)\t\(.metadata.namespace)"' | while IFS=$'\t' read -r clusterName clusterNameSpace; do	
	
    echo "Found ClusterName:   $clusterName NameSpace: $clusterNameSpace"
  	  
	  theCommand="nkp get kubeconfig --cluster-name=$clusterName --namespace=$clusterNameSpace --kubeconfig=$targetMCKC" 
	
		echo " Getting Kubeconfig: $clusterName"
	
		# Ignore warnings..
		$theCommand 2> /dev/null > "./${clusterName}-kubeconfig.conf"
	    
	  echo " " 
	    
	done
	
	echo " " 		
	
}



#
# Main
#

 	if [ $# -lt 2 ]
 		then

 			echo ""
 			echo "" 		
 			echo "****ERROR: No Target-Management-Cluster-KubeConfig specified!"
 			echo ""
 			echo "" 		
 		
			usage
			
 	fi	

	arg_parse "$@"

	check_for_mc_kubeconfig
	
	check_for_dependancyZ
	
  grab_cluster_data

	process_clusterZ	



	
	exit 0
	
	