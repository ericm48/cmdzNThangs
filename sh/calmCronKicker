i=0
k=0

	unamestr=$(uname)	

	# Linux IMPL
	baseDir=""
	
	if [ "$unamestr" = 'Darwin' ] 
		then
		
			# MAC-os Impl:
	   	baseDir="/Users/eric.manley"

	fi 

usage(){
   			echo " "
   			echo " "
   			echo " "
   			echo "Usage:      $0 targetClusterName   -Kick off calm automation from cron"
   			echo " "
   			echo " -H/-h                                           -Display this help message."
   			echo " "
   			echo " "
   			echo " Example:   $0 -t PHX-POC236       -Runs the HPOC build command for cluster PHX-POC236"						   			
   			echo " "   			
   			echo " "   			
	exit 1
}

arg_parse() {
	
	for (( i=1; i<=$#; i++)); do
		
		case ${!i} in

		  -t)
		  		# targetClusterName after  -t
		  	  k=$(($i+1))
				 	targetClusterName="${!k}"
				 	;;

	    -H)
					usage
					exit 3
	        ;;
	
	    -h)
					usage
					exit 3
					;;
	
	    --H)
					usage
					exit 3
	        ;;
	
	    --h)
					usage
					exit 3
					;;
	
	    -help)
					usage
					exit 3
	        ;;
	
	    --help)
					usage
					exit 3
					;;
			
			*)
					#echo "[$i]: ${!i}"
		
		
		esac
	
	  
	done

}

