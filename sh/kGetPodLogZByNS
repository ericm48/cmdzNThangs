#!/bin/bash

#set -x

targetNameSpace=
targetNameSpace="default"

sinceDuration=
sinceDuration="2m"

targetPodNameFilter=
targetPodNameFilter=""

i=0
k=0

usage(){
   			echo " "
   			echo " "
   			echo " "
   			echo "Usage:   $0		 -Grabs & Outputs ALL Pod-Logs for a given Namespace"
   			echo " "
   			echo " -H/-h         -Display this help message."
   			echo " -n            -TargetNameSpace -Optional.  Default: default"
   			echo " -p            -PodName Filter  -Optional.  If not specified, gets ALL pod logs in that NS."   			
   			echo " -s            -SinceDuration   -Optional.  As a time duration, (ie 6m for last 6 minutes). Default: 2m"
   			echo " "
   			echo " "
   			echo " "   			
   			echo " Example:   $0 -n targetNameSpace          -Gets all pod logs in targetNameSpace."
   			echo " "   			
   			echo " Example:   $0 -n targetNameSpace -p graf  -Gets ONLY pod logs in targetNameSpace that have graf in the name."
   			echo " "   			   			
   			echo " Example:   $0 -n targetNameSpace -s 10m   -Gets ONLY pod logs entries in last 10min in targetNameSpace."						
   			echo " "
   			echo " "   			
	exit 1
}

arg_parse() {
	
	for (( i=1; i<=$#; i++)); do
		
		case ${!i} in
				 	
		  -n)
		  		# targetNameSpace after  -n
		  	  k=$(($i+1))
				 	targetNameSpace="${!k}"
				 	;;
				 	
		  -p)
		  		# targetPodNameFilter after  -p
		  	  k=$(($i+1))
				 	targetPodNameFilter="${!k}"
				 	;;			 	
				 	
	
			-s)
		  		# sinceDuration after  -s
		  	  k=$(($i+1))
				 	sinceDuration="${!k}"
				 	;;

			-f)
		  		# targetNameFragment after  -f
		  	  k=$(($i+1))
				 	targetNameFragment="${!k}"
				 	;;				 					 	
	
	    -H)
					usage
					exit 3
	        ;;
	
	    -h)
					usage
					exit 3
					;;
	
	    --H)
					usage
					exit 3
	        ;;
	
	    --h)
					usage
					exit 3
					;;
	
	    -help)
					usage
					exit 3
	        ;;
	
	    --help)
					usage
					exit 3
					;;
			
			*)
					#echo "[$i]: ${!i}"
		
		
		esac
	
	  
	done

}

calc_num_podz(){

  theCommand=""
  
	if [[ -n "$targetPodNameFilter" ]]
		then

	    theCommand="kubectl get pods -n $targetNameSpace |grep $targetPodNameFilter |wc -l"

	    
	  else
	    theCommand="kubectl get pods -n $targetNameSpace |wc -l"	  
	fi

  numPodZ=$(eval "$theCommand")

	numPodZ="${numPodZ#"${numPodZ%%[![:space:]]*}"}"

	echo "       Number of Pods: $numPodZ"

}

dump_logz() {

	theCommand=""

	for pod in $(kubectl get pods -n $targetNameSpace -o jsonpath='{.items[*].metadata.name}'); do 
	    
	    # Filter on pods by name if specified...
	    
			if [[ -n "$targetPodNameFilter" ]]
				then
				
					if [[ "$pod" != *"$targetPodNameFilter"* ]]
					 	then

					 		continue   					    
					fi			
			fi
	    
	    echo "=== Logs For Pod: $pod BEGINS ==="
	    
	    theCommand=""
	    theCommand="kubectl logs -n $targetNameSpace $pod --all-containers=true "

			if [[ ! -z "$sinceDuration" ]]; then
				#theCommand="kubectl logs -n $targetNameSpace $pod --all-containers=true --since $sinceDuration "
				
				theCommand="$theCommand --since $sinceDuration "				
			fi
	    
	    #echo "theCommand: $theCommand"
	    
	    # Run IT!
	    $theCommand			
	    
			echo "=== Logs For Pod: $pod ENDS   ==="
			
	done

}

	arg_parse "$@"

	if [[ -z "$targetPodNameFilter" ]]
		then
  		podNameFilterDisplay="ALL"
  		
  	else
  		podNameFilterDisplay="$targetPodNameFilter"
	fi
	
	
	echo " "
	echo "     Target NameSpace: $targetNameSpace"
	echo " Target PodNameFilter: $podNameFilterDisplay"	
	echo "       Since Duration: $sinceDuration"	

	calc_num_podz

	echo " "
		
	dump_logz 
	
	exit 0
	
	